# Django production baseline. Generate a long random secret and inject it from a
# secret manager; never commit the production value.
DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-development-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# GitHub Integration Configuration
GITHUB_USERNAME=your_github_username
GITHUB_TOKEN=your_github_personal_access_token

# Google Gemini Configuration (Primary Provider)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Optional Additional LLM Providers (for Router Waterfall & Fallbacks)
GROQ_API_KEY=your_groq_api_key
CEREBRAS_API_KEY=your_cerebras_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
OLLAMA_HOST=http://localhost:11434

# Lead discovery providers
# Google Places is enabled by default when a key exists. Set the flag to False
# to disable it without removing the key. GOOGLE_MAPS_API_KEY remains supported
# as a legacy key name.
GOOGLE_PLACES_ENABLED=True
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_TIMEOUT_SECONDS=10

# Apollo Organization Search. The API key must include access to
# api/v1/mixed_companies/search. This endpoint consumes Apollo credits.
APOLLO_ENABLED=True
APOLLO_API_KEY=
APOLLO_TIMEOUT_SECONDS=15

# Optional fallback Google Maps scraper.
APIFY_API_TOKEN=your_apify_api_token

# Per-discovery visual execution traces
DISCOVERY_TRACE_ENABLED=True
# Optional: defaults to <project>/discovery_traces
# DISCOVERY_TRACE_DIR=C:/path/to/discovery_traces
# Maximum characters retained in any individual prompt/scrape field
DISCOVERY_TRACE_STRING_LIMIT=100000

# Router Fallback Priority Order (Commas separated: gemini-flash, groq, ollama, cerebras, openrouter)
# Master order across all tiers (Uncomment to override everything with a single list):
# ROUTER_PROVIDER_PRIORITY=ollama,groq,gemini-flash,cerebras,openrouter

# Tier-Specific Priority Overrides (Uncomment to set per-tier lists):
# ROUTER_FALLBACK_SIMPLE=groq,ollama,cerebras,openrouter,gemini-flash
# ROUTER_FALLBACK_MEDIUM=groq,openrouter,gemini-flash,ollama,cerebras
# ROUTER_FALLBACK_CRITICAL=gemini-flash,groq,openrouter,cerebras,ollama

# Optional Model Overrides per Provider
GROQ_MODEL=mixtral-8x7b-32768
CEREBRAS_MODEL=llama3.1-8b
OPENROUTER_MODEL=meta-llama/llama-3-8b-instruct:free

# PostgreSQL Database Credentials
POSTGRES_DB=aios_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Maximum number of leads to collect and enrich per discovery run to control LLM cost
PROSPECTING_MAX_LEADS_PER_RUN=10

# Instagram CRM Integration
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/v3/integrations/instagram/oauth/callback/
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=your_instagram_webhook_verify_token
INSTAGRAM_GRAPH_API_VERSION=v21.0
INSTAGRAM_TOKEN_ENCRYPTION_KEY=your_fernet_or_aes_secret_key_32_bytes
INSTAGRAM_HTTP_TIMEOUT_SECONDS=15
INSTAGRAM_MAX_RETRY_ATTEMPTS=3

# LinkedIn content automation — recommended Company Page delivery
# Explicit local-development compatibility mode. Keep false in production.
CONTENT_AUTOMATION_DEV_BOOTSTRAP=False
CONTENT_AUTOMATION_ASSET_TOKEN_MAX_AGE_SECONDS=2592000
BUFFER_API_URL=https://api.buffer.com
BUFFER_API_KEY=
BUFFER_CHANNEL_ID=

# Optional n8n delivery. PERSON avoids Company Page review but posts to the
# authenticated member profile. ORGANIZATION still needs approved Page access,
# or the n8n workflow must hand the post to Buffer.
SOCIAL_PUBLISHER_DEFAULT=UPLOAD_POST
UPLOAD_POST_API_BASE_URL=https://api.upload-post.com/api
UPLOAD_POST_API_KEY=
UPLOAD_POST_WEBHOOK_SECRET=
UPLOAD_POST_CONNECTION_RETURN_URL=
UPLOAD_POST_HTTP_TIMEOUT_SECONDS=30
ZERNIO_API_BASE_URL=https://zernio.com/api
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=
ZERNIO_CONNECTION_RETURN_URL=
ZERNIO_HTTP_TIMEOUT_SECONDS=30
SOCIAL_PUBLISH_MAX_ATTEMPTS=3
SOCIAL_PUBLISH_RETRY_BASE_SECONDS=60
SOCIAL_PUBLISH_RETRY_MAX_SECONDS=900
SOCIAL_PUBLISH_CLAIM_TTL_SECONDS=300
SOCIAL_HEALTH_OVERDUE_JOB_MINUTES=10
SOCIAL_HEALTH_FAILED_JOB_THRESHOLD=5
# Allow first-run users to continue in draft-only mode without a social connection.
CONTENT_STUDIO_DRAFT_ONLY_ALLOWED=True
# Enable advisory semantic checks (voice, source support and attribution) through the LLM router.
# These suggestions never create hard approval blockers.
SOCIAL_QUALITY_LLM_ENABLED=True
N8N_LINKEDIN_WEBHOOK_URL=
N8N_LINKEDIN_WEBHOOK_SECRET=
N8N_LINKEDIN_TARGET=PERSON

# Legacy generic publisher webhook
LINKEDIN_PUBLISH_WEBHOOK_URL=
LINKEDIN_PUBLISH_WEBHOOK_SECRET=
LINKEDIN_HTTP_TIMEOUT_SECONDS=60
# Require a signed Unix timestamp for the legacy callback in production.
LINKEDIN_LEGACY_CALLBACK_REQUIRE_TIMESTAMP=False
LINKEDIN_LEGACY_CALLBACK_MAX_AGE_SECONDS=300

# Optional AI image generation. "auto" uses Gemini first, then OpenAI.
LINKEDIN_GENERATE_IMAGES=False
LINKEDIN_IMAGE_PROVIDER=auto
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_SIZE=1K
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_QUALITY=high
PUBLIC_BACKEND_URL=http://localhost:8000

# Social media storage. Production should point both aliases at private/object-storage
# backends; only the publish derivative storage should expose stable public URLs.
SOCIAL_MEDIA_PRIVATE_ROOT=
SOCIAL_MEDIA_PUBLISH_ROOT=
SOCIAL_MEDIA_PRIVATE_STORAGE_BACKEND=django.core.files.storage.FileSystemStorage
SOCIAL_MEDIA_PUBLISH_STORAGE_BACKEND=django.core.files.storage.FileSystemStorage
# JSON passed to non-filesystem storage backends (bucket, region, custom domain, etc.).
SOCIAL_MEDIA_PRIVATE_STORAGE_OPTIONS={}
SOCIAL_MEDIA_PUBLISH_STORAGE_OPTIONS={}
# Comma-separated legacy CDN hostnames permitted as publish sources. Empty is safest.
SOCIAL_MEDIA_EXTERNAL_URL_ALLOWLIST=
